{
  "name": "diario-de-estudos",
  "version": "2.0.0",
  "description": "Workspace de estudos com login, perfil personalizável e API REST (Express + PostgreSQL/SQLite)",
  "engines": {
    "node": ">=20.12.0"
  },
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "npm --prefix client ci && npm --prefix client run build",
    "test": "node --test && npm --prefix client run test:unit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^10.9.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "better-sqlite3": "^12.11.1",
    "pg-mem": "^3.0.14"
  }
}
