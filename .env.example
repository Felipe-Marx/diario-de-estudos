PORT=3000
# URL PostgreSQL (Supabase). Em produção é obrigatória; use o pooler para funções serverless.
DATABASE_URL=
# Certificado raiz PEM do Supabase para validar TLS quando a CA não estiver no sistema.
DATABASE_CA_CERT=
# Caminho alternativo do SQLite local (ignorado quando DATABASE_URL está configurada)
DB_PATH=
# Segredo dos tokens de login. Deixe vazio para gerar um automaticamente (.jwt-secret)
JWT_SECRET=
# ID do cliente OAuth do Google (veja o README). Vazio = botão do Google desativado
GOOGLE_CLIENT_ID=
# Use "production" ao publicar com HTTPS
NODE_ENV=
