PORT=3000
# Caminho alternativo do SQLite (opcional; padrão: estudos.db na raiz)
DB_PATH=
# Segredo dos tokens de login. Deixe vazio para gerar um automaticamente (.jwt-secret)
JWT_SECRET=
# ID do cliente OAuth do Google (veja o README). Vazio = botão do Google desativado
GOOGLE_CLIENT_ID=
# Use "production" ao publicar com HTTPS
NODE_ENV=
